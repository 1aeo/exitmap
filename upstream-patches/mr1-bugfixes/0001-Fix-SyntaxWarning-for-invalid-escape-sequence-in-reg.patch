From 4afec896c78f51c80d87e5553364f375403d2a89 Mon Sep 17 00:00:00 2001
From: 1aeo <github@1aeo.com>
Date: Tue, 3 Mar 2026 04:46:13 +0000
Subject: [PATCH 1/3] Fix SyntaxWarning for invalid escape sequence in regex

Use raw string (r'...') for regex pattern containing backslash
escape sequences to avoid Python 3.12+ SyntaxWarning.

Co-authored-by: 1aeo <1aeo@users.noreply.github.com>
---
 src/util.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/util.py b/src/util.py
index f2b2dd8..030738d 100644
--- a/src/util.py
+++ b/src/util.py
@@ -90,7 +90,7 @@ def get_source_port(stream_line):
     Extract the source port from a stream event.
     """
 
-    pattern = "SOURCE_ADDR=[0-9\.]{7,15}:([0-9]{1,5})"
+    pattern = r"SOURCE_ADDR=[0-9\.]{7,15}:([0-9]{1,5})"
     match = re.search(pattern, stream_line)
 
     if match:
-- 
