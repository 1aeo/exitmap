-        for proc in multiprocessing.active_children():
-            log.debug(
-                "Terminating remaining PID %d with name %s.",
-                proc.pid, proc.name
-            )
-            proc.terminate()
+        # Grace period for straggling processes
+        terminated = []
+        active = multiprocessing.active_children()
+        if active:
+            per_proc = max(1, 10 // len(active))
+            for proc in active:
+                proc.join(timeout=per_proc)
+                if proc.is_alive():
+                    fpr = self.pid_to_fingerprint.get(proc.pid)
+                    if fpr:
+                        terminated.append(fpr)
+                    log.debug(
+                        "Terminating remaining PID %d with name %s.",
+                        proc.pid, proc.name
+                    )
+                    proc.terminate()
+        if terminated:
+            log.info("Terminated %d stalled relays.", len(terminated))
 
