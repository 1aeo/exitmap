From 573e20c5da3209158b457ce4981ed86efc3e70a7 Mon Sep 17 00:00:00 2001
From: 1aeo <tor@1aeo.com>
Date: Thu, 5 Mar 2026 04:50:56 +0000
Subject: [PATCH 3/5] Fix gzip decompression to use BytesIO instead of StringIO

HTTP response data is bytes in Python 3. io.StringIO(data) raises
TypeError, which is silently caught by the except clause. This causes
decompress() to return raw compressed data, so CAPTCHA detection never
matches. Fixed by using io.BytesIO.
---
 src/modules/cloudflared.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/modules/cloudflared.py b/src/modules/cloudflared.py
index a2cf327..d7d7461 100644
--- a/src/modules/cloudflared.py
+++ b/src/modules/cloudflared.py
@@ -58,7 +58,7 @@ def decompress(data):
     """
 
     try:
-        buf = io.StringIO(data)
+        buf = io.BytesIO(data)
         fileobj = gzip.GzipFile(fileobj=buf)
         data = fileobj.read()
     except Exception:
